pipeline {
    agent any

    environment {
        SERVICE_NAME          = 'frontend'
        APP_DIR               = 'frontend'

        APP_REPO_URL          = 'https://github.com/truelykh/simple-store-app.git'
        GITOPS_REPO_URL       = 'https://github.com/truelykh/simple-store-app.git'

        NEXUS_DOCKER_REGISTRY = 'nexus-svc.nexus.svc.cluster.local:8082'
        IMAGE_PREFIX          = 'truelykh'

        GITHUB_CRED_ID        = 'github-pat'
        NEXUS_CRED_ID         = 'nexus-credentials'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    triggers {
        githubPush()
    }

    stages {
        stage('1. SCM Checkout') {
            steps {
                checkout scm
            }
        }

        stage('2. Build Frontend') {
            steps {
                sh 'echo "Frontend is built inside Docker multi-stage build using node:22-alpine"'
            }
        }

        stage('3. Docker Build') {
            steps {
                sh """
                    docker build \
                      -t "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${BUILD_NUMBER}" \
                      "${APP_DIR}"
                """
            }
        }

        stage('4. Trivy Scan') {
            steps {
                sh """
                    trivy image \
                      --cache-dir "\${WORKSPACE}/.trivy-cache" \
                      --scanners vuln \
                      --severity HIGH,CRITICAL \
                      --no-progress \
                      --exit-code 0 \
                      "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${BUILD_NUMBER}"
                """
            }
        }

        stage('5. Push Image to Nexus') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    expression { env.BRANCH_NAME == null }
                }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.NEXUS_CRED_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh """
                        echo "\$NEXUS_PASS" | docker login \
                          "${NEXUS_DOCKER_REGISTRY}" \
                          -u "\$NEXUS_USER" \
                          --password-stdin

                        docker push "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${BUILD_NUMBER}"
                    """
                }
            }
        }

        stage('6. Update GitOps') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    expression { env.BRANCH_NAME == null }
                }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.GITHUB_CRED_ID,
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh """
                        rm -rf gitops-repo
                        git clone https://${GH_TOKEN}@github.com/truelykh/simple-store-app.git gitops-repo
                        cd gitops-repo/k8s-manifests/${SERVICE_NAME}
                        sed -i 's|image: .*|image: ${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${BUILD_NUMBER}|g' deployment.yaml
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@simple-store.local"
                        git add deployment.yaml
                        git diff --staged --quiet || git commit -m "Automated update: ${SERVICE_NAME} image tag to ${BUILD_NUMBER}"
                        git push origin main
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
