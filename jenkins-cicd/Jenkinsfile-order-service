pipeline {
    agent any

    environment {
        SERVICE_NAME          = 'order-service'
        APP_DIR               = 'order-service'
        APP_GROUP_ID          = 'com.simplestore'

        APP_REPO_URL          = 'https://github.com/truelykh/simple-store-app.git'
        GITOPS_REPO_URL       = 'https://github.com/truelykh/simple-store-gitops.git'

        NEXUS_HOST            = 'nexus-svc.nexus.svc.cluster.local:8081'
        NEXUS_DOCKER_REGISTRY = 'nexus-svc.nexus.svc.cluster.local:8082'
        NEXUS_MAVEN_REPO      = 'maven-releases'
        IMAGE_PREFIX          = 'truelykh'

        GITHUB_CRED_ID        = 'github-pat'
        NEXUS_CRED_ID         = 'nexus-credentials'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('1. SCM Checkout') {
            steps {
                checkout scm
            }
        }

        stage('2. Unit Tests') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B test'
                }
            }
        }

        stage('3. Build & Package') {
            steps {
                script {
                    env.APP_VERSION = "1.${BUILD_NUMBER.toInteger() - 1}"
                }

                dir(env.APP_DIR) {
                    sh "mvn -B -Drevision=${APP_VERSION} clean package"
                }
            }
        }

        stage('4. Publish JAR to Nexus') {
            when {
                branch 'main'
            }
            steps {
                script {
                    env.APP_VERSION = "1.${BUILD_NUMBER.toInteger() - 1}"
                }

                dir(env.APP_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: env.NEXUS_CRED_ID,
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASS'
                        )
                    ]) {
                        sh '''
                            groupPath=$(echo "${APP_GROUP_ID}" | tr '.' '/')
                            jarFile="target/app.jar"

                            curl -sSf \
                              -u "${NEXUS_USER}:${NEXUS_PASS}" \
                              --upload-file "$jarFile" \
                              "http://${NEXUS_HOST}/repository/${NEXUS_MAVEN_REPO}/${groupPath}/${SERVICE_NAME}/${APP_VERSION}/${SERVICE_NAME}-${APP_VERSION}.jar"
                        '''
                    }
                }
            }
        }

        stage('5. Docker Build') {
            steps {
                sh """
                    docker build \
                      -t "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${BUILD_NUMBER}" \
                      "${APP_DIR}"
                """
            }
        }

        stage('6. Trivy Scan') {
            steps {
                sh """
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --no-progress \
                      --exit-code 0 \
                      "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${BUILD_NUMBER}"
                """
            }
        }

        stage('7. Push Image to Nexus') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.NEXUS_CRED_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh """
                        echo "\$NEXUS_PASS" | docker login \
                          "${NEXUS_DOCKER_REGISTRY}" \
                          -u "\$NEXUS_USER" \
                          --password-stdin

                        docker push "${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${BUILD_NUMBER}"
                    """
                }
            }
        }

        stage('8. Update GitOps') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.GITHUB_CRED_ID,
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh """
                        rm -rf gitops-repo
                        git clone https://${GH_TOKEN}@github.com/truelykh/simple-store-gitops.git gitops-repo
                        cd gitops-repo/${SERVICE_NAME}
                        sed -i 's|image: .*|image: ${NEXUS_DOCKER_REGISTRY}/${IMAGE_PREFIX}/${SERVICE_NAME}:${BUILD_NUMBER}|g' deployment.yaml
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@simple-store.local"
                        git add deployment.yaml
                        git commit -m "Automated update: ${SERVICE_NAME} image tag to ${BUILD_NUMBER}"
                        git push origin main
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
